{
  "name": "@lsongdev/stylesheets",
  "version": "1.3.3",
  "description": "Semantic-token CSS components: plain stylesheets, no build step to use them.",
  "license": "MIT",
  "type": "module",
  "style": "index.css",
  "exports": {
    ".": "./index.css",
    "./theme/*": "./theme/*",
    "./*.css": "./*.css",
    "./package.json": "./package.json",
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "*.css",
    "theme/",
    "fonts/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsongdev/stylesheets.git"
  }
}
